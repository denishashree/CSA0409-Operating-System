#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char data[] = "File Management Operations";
    char buffer[100];
    int n;

    fd = open("/tmp/file.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if(fd < 0)
    {
        printf("File cannot be opened.\n");
        return 1;
    }

    printf("File created successfully.\n");

    write(fd, data, sizeof(data) - 1);
    printf("Data written successfully.\n");

    lseek(fd, 0, SEEK_SET);

    n = read(fd, buffer, sizeof(buffer) - 1);
    buffer[n] = '\0';

    printf("File Content: %s\n", buffer);

    close(fd);
    printf("File closed successfully.\n");

    return 0;
}
