#include <stdio.h>

int main()
{
    char users[5][20];
    char files[5][5][20];
    int u, f, i, j;

    printf("Enter number of users: ");
    scanf("%d", &u);

    for(i = 0; i < u; i++)
    {
        printf("\nEnter user %d name: ", i + 1);
        scanf("%s", users[i]);

        printf("Enter number of files: ");
        scanf("%d", &f);

        printf("Enter file names:\n");
        for(j = 0; j < f; j++)
            scanf("%s", files[i][j]);
    }

    printf("\nTwo-Level Directory:\n");

    for(i = 0; i < u; i++)
    {
        printf("\nUser: %s\n", users[i]);

        for(j = 0; j < 5; j++)
        {
            if(files[i][j][0] != '\0')
                printf("  %s\n", files[i][j]);
        }
    }

    return 0;
}
