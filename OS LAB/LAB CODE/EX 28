#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char word[50], line[200];

    fp = fopen("/etc/hostname", "r");

    if(fp == NULL)
    {
        printf("File cannot be opened.\n");
        return 1;
    }

    printf("Enter word to search: ");
    scanf("%s", word);

    printf("\nMatching lines:\n");

    while(fgets(line, sizeof(line), fp) != NULL)
    {
        if(strstr(line, word) != NULL)
            printf("%s", line);
    }

    fclose(fp);

    return 0;
}
