#include <stdio.h>

int main()
{
    int block[10], process[10];
    int n, m, i, j;

    printf("Enter number of memory blocks: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &m);

    printf("Enter process sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &process[i]);

    printf("\nMemory Allocation:\n");

    for(i = 0; i < m; i++)
    {
        for(j = 0; j < n; j++)
        {
            if(block[j] >= process[i])
            {
                printf("Process %d (%d KB) -> Block %d (%d KB)\n",
                       i + 1, process[i], j + 1, block[j]);

                block[j] -= process[i];
                break;
            }
        }

        if(j == n)
            printf("Process %d (%d KB) -> Not Allocated\n",
                   i + 1, process[i]);
    }

    return 0;
}
