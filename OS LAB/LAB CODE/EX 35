#include <stdio.h>

int main()
{
    int index, n, blocks[20];
    int i;

    printf("Enter index block: ");
    scanf("%d", &index);

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter file block numbers:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &blocks[i]);
    }

    printf("\nIndex Block: %d\n", index);

    printf("Allocated Blocks:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", blocks[i]);
    }

    printf("\n");

    return 0;
}
