#include <stdio.h>

int main()
{
    int block[20], n, i;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("\nLinked File Allocation:\n");

    for(i = 0; i < n; i++)
    {
        if(i == n - 1)
            printf("%d -> NULL\n", block[i]);
        else
            printf("%d -> ", block[i]);
    }

    return 0;
}
