5. Develop a secure file backup utility using low-level file system calls.
ANS:
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
int main(int argc, char *argv[])
{
    int src, dest;
    char buffer[1024];
    int bytes;
    if(argc != 3)
    {
        printf("Usage: ./backup source.txt backup.txt\n");
        return 1;
    }
    src = open(argv[1], O_RDONLY);
    if(src < 0)
    {
        printf("Source file not found.\n");
        return 1;
    }
    dest = open(argv[2], O_CREAT | O_WRONLY | O_TRUNC, 0600);
    while((bytes = read(src, buffer, sizeof(buffer))) > 0)
    {
        write(dest, buffer, bytes);
    }
    close(src);
    close(dest);
    printf("Backup Created Successfully.\n");
    return 0;
}
