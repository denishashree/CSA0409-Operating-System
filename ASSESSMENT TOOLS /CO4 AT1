5. File Allocation + Disk Scheduling Integration:
#include <stdio.h>
#include <stdlib.h>

#define MAX 1000

int disk[MAX];

int contiguous(int n, int size) {
    int i, j;

    for (i = 0; i <= n - size; i++) {
        int freeSpace = 1;

        for (j = 0; j < size; j++) {
            if (disk[i + j] == 1) {
                freeSpace = 0;
                break;
            }
        }

        if (freeSpace) {
            for (j = 0; j < size; j++)
                disk[i + j] = 1;

            return i;
        }
    }

    return -1;
}

int indexed(int n, int size, int blocks[]) {
    int i, count = 0;

    /* First block is index block */
    for (i = 0; i < n; i++) {
        if (disk[i] == 0) {
            disk[i] = 1;
            break;
        }
    }

    if (i == n)
        return -1;

    for (i = 0; i < n && count < size; i++) {
        if (disk[i] == 0) {
            disk[i] = 1;
            blocks[count] = i;
            count++;
        }
    }

    if (count < size)
        return -1;

    return 1;
}

int fcfs(int request[], int n, int head, int allocated[]) {
    int i, j;
    int total = 0;
    int current = head;

    printf("\nFCFS Seek Sequence: %d ", head);

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (request[i] == allocated[j]) {
                total += abs(current - request[i]);
                current = request[i];
                printf("-> %d ", current);
                break;
            }
        }
    }

    return total;
}

int sstf(int allocated[], int n, int head) {
    int visited[MAX] = {0};
    int i, count;
    int current = head;
    int total = 0;

    printf("\nSSTF Seek Sequence: %d ", head);

    for (count = 0; count < n; count++) {
        int min = 999999;
        int index = -1;

        for (i = 0; i < n; i++) {
            if (!visited[i]) {
                int distance = abs(current - allocated[i]);

                if (distance < min) {
                    min = distance;
                    index = i;
                }
            }
        }

        visited[index] = 1;
        total += abs(current - allocated[index]);
        current = allocated[index];

        printf("-> %d ", current);
    }

    return total;
}

int main() {
    int n, fileSize, method;
    int head;
    int i, result;
    int allocated[MAX];

    printf("Enter total disk blocks: ");
    scanf("%d", &n);

    printf("Enter file size: ");
    scanf("%d", &fileSize);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nAllocation Method:\n");
    printf("1. Contiguous\n");
    printf("2. Indexed\n");
    printf("Enter choice: ");
    scanf("%d", &method);

    /* Initially all blocks are free */
    for (i = 0; i < n; i++)
        disk[i] = 0;

    /* File allocation */
    if (method == 1) {

        result = contiguous(n, fileSize);

        if (result == -1) {
            printf("\nContiguous allocation failed.\n");
            return 0;
        }

        for (i = 0; i < fileSize; i++)
            allocated[i] = result + i;

    } else if (method == 2) {

        result = indexed(n, fileSize, allocated);

        if (result == -1) {
            printf("\nIndexed allocation failed.\n");
            return 0;
        }

    } else {
        printf("Invalid allocation method.\n");
        return 0;
    }

    printf("\nAllocated blocks: ");

    for (i = 0; i < fileSize; i++)
        printf("%d ", allocated[i]);

    /* FCFS */
    printf("\n\n--- FCFS ---");

    int fcfsTime = fcfs(allocated, fileSize, head, allocated);

    printf("\nTotal Seek Time = %d\n", fcfsTime);

    /* SSTF */
    printf("\n--- SSTF ---");

    int sstfTime = sstf(allocated, fileSize, head);

    printf("\nTotal Seek Time = %d\n", sstfTime);

    /* Comparison */
    printf("\n--- PERFORMANCE COMPARISON ---\n");

    if (fcfsTime < sstfTime)
        printf("FCFS performs better with %d seek time.\n", fcfsTime);
    else if (sstfTime < fcfsTime)
        printf("SSTF performs better with %d seek time.\n", sstfTime);
    else
        printf("Both algorithms have equal seek time: %d\n", fcfsTime);

    return 0;
}
