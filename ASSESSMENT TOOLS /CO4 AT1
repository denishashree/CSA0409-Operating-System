4. C-SCAN and LOOK Disk Scheduling:
#include <stdio.h>
#include <stdlib.h>

#define MAX 100

void cscan(int request[], int n, int head, int diskSize, char direction) {
    int temp[MAX], i, j;
    int total = 0, current = head;

    for (i = 0; i < n; i++)
        temp[i] = request[i];

    /* Sort */
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (temp[i] > temp[j]) {
                int t = temp[i];
                temp[i] = temp[j];
                temp[j] = t;
            }
        }
    }

    printf("\nC-SCAN Seek Sequence: %d ", head);

    if (direction == 'R' || direction == 'r') {

        /* Move right */
        for (i = 0; i < n; i++) {
            if (temp[i] >= head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }

        /* Move to end */
        total += abs(current - (diskSize - 1));
        current = diskSize - 1;
        printf("-> %d ", current);

        /* Jump to beginning */
        total += diskSize - 1;
        current = 0;
        printf("-> %d ", current);

        /* Continue right */
        for (i = 0; i < n; i++) {
            if (temp[i] < head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }
    }

    else {
        /* Move left */
        for (i = n - 1; i >= 0; i--) {
            if (temp[i] <= head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }

        /* Move to beginning */
        total += current;
        current = 0;
        printf("-> %d ", current);

        /* Jump to end */
        total += diskSize - 1;
        current = diskSize - 1;
        printf("-> %d ", current);

        /* Continue left */
        for (i = n - 1; i >= 0; i--) {
            if (temp[i] > head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }
    }

    printf("\nTotal Head Movement = %d\n", total);
}

void look(int request[], int n, int head, char direction) {
    int temp[MAX], i, j;
    int total = 0, current = head;

    for (i = 0; i < n; i++)
        temp[i] = request[i];

    /* Sort */
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (temp[i] > temp[j]) {
                int t = temp[i];
                temp[i] = temp[j];
                temp[j] = t;
            }
        }
    }

    printf("\nLOOK Seek Sequence: %d ", head);

    if (direction == 'R' || direction == 'r') {

        /* Move right */
        for (i = 0; i < n; i++) {
            if (temp[i] >= head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }

        /* Reverse */
        for (i = n - 1; i >= 0; i--) {
            if (temp[i] < head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }
    }

    else {

        /* Move left */
        for (i = n - 1; i >= 0; i--) {
            if (temp[i] <= head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }

        /* Reverse */
        for (i = 0; i < n; i++) {
            if (temp[i] > head) {
                total += abs(current - temp[i]);
                current = temp[i];
                printf("-> %d ", current);
            }
        }
    }

    printf("\nTotal Head Movement = %d\n", total);
}

int main() {
