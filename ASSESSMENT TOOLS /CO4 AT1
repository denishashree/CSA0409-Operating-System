1. File Allocation — Contiguous, Linked and Indexed
#include <stdio.h>
#define MAX 1000
int main() {
    int disk[MAX] = {0};
    int n, fileSize, method;
    int i, j, start = -1, count = 0;
    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);
    printf("Enter file size (number of blocks): ");
    scanf("%d", &fileSize);
    printf("Enter allocation method:\n");
    printf("1. Contiguous\n");
    printf("2. Linked\n");
    printf("3. Indexed\n");
    printf("Enter choice: ");
    scanf("%d", &method);
    if (n > MAX || fileSize <= 0 || fileSize > n) {
        printf("Invalid input.\n");
        return 0;
    }
    /* Some blocks are assumed to be already occupied */
    printf("Enter number of already allocated blocks: ");
    scanf("%d", &count);
    printf("Enter allocated block numbers:\n");
    for (i = 0; i < count; i++) {
        scanf("%d", &j);
        if (j >= 0 && j < n)
            disk[j] = 1;
    }
    /* CONTIGUOUS */
    if (method == 1) {
        for (i = 0; i <= n - fileSize; i++) {
            int freeSpace = 1;
            for (j = 0; j < fileSize; j++) {
                if (disk[i + j] == 1) {
                    freeSpace = 0;
                    break;
                }
            }
            if (freeSpace) {
                start = i;
                break;
            }
        }
        if (start == -1) {
            printf("\nContiguous allocation failed.\n");
            printf("Sufficient continuous space is not available.\n");
        } else {
            printf("\nAllocated blocks: ");
            for (i = start; i < start + fileSize; i++) {
                disk[i] = 1;
                printf("%d ", i);
            }
            printf("\n");
        }
    }
    /* LINKED */
    else if (method == 2) {
        count = 0;
        printf("\nAllocated blocks: ");
        for (i = 0; i < n && count < fileSize; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
        if (count < fileSize)
            printf("\nLinked allocation failed. Insufficient free blocks.\n");
        else
            printf("\nLinked allocation successful.\n");
    }
    /* INDEXED */
    else if (method == 3) {
        int indexBlock = -1;
        /* Find index block */
        for (i = 0; i < n; i++) {
            if (disk[i] == 0) {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }
        if (indexBlock == -1) {
            printf("\nIndexed allocation failed.\n");
            return 0;
        }
        count = 0;
        for (i = 0; i < n && count < fileSize; i++) {
            if (disk[i] == 0)
                count++;
        }
        if (count < fileSize) {
            printf("\nIndexed allocation failed. Insufficient free blocks.\n");
            return 0;
        }
        printf("\nIndex block: %d\n", indexBlock);
        printf("Allocated data blocks: ");
        count = 0;
        for (i = 0; i < n && count < fileSize; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
        printf("\nIndexed allocation successful.\n");
    }
    else {
        printf("Invalid allocation method.\n");
    }
    return 0;
}
INPUT:
Enter total number of disk blocks: 20
Enter file size (number of blocks): 5
Enter allocation method:
1. Contiguous
2. Linked
3. Indexed
Enter choice: 1
Enter number of already allocated blocks: 4
Enter allocated block numbers:
0 1 2 10
OUTPUT:
Allocated blocks: 3 4 5 6 7

2. Bitmap Disk Space Management
#include <stdio.h>
#define MAX 1000
int main() {
    int bitmap[MAX];
    int n, i, freeBlocks = 0;
    int request, allocated = 0;
    int deallocateCount, block;
    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);
    if (n > MAX) {
        printf("Disk size exceeds limit.\n");
        return 0;
    }
    printf("Enter initial bitmap (0 = free, 1 = allocated):\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &bitmap[i]);
        if (bitmap[i] == 0)
            freeBlocks++;
    }
    printf("\nEnter number of blocks to allocate: ");
    scanf("%d", &request);
    if (request > freeBlocks) {
        printf("Allocation failed.\n");
        printf("Only %d free blocks are available.\n", freeBlocks);
    } else {
        for (i = 0; i < n && allocated < request; i++) {
            if (bitmap[i] == 0) {
                bitmap[i] = 1;
                allocated++;
            }
        }
        printf("Allocation successful.\n");
    }
    printf("\nBitmap after allocation:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    /* Deallocation */
    printf("\n\nEnter number of blocks to deallocate: ");
    scanf("%d", &deallocateCount);
    printf("Enter block numbers to deallocate:\n");
    for (i = 0; i < deallocateCount; i++) {
        scanf("%d", &block);
        if (block >= 0 && block < n) {
            if (bitmap[block] == 1) {
                bitmap[block] = 0;
                printf("Block %d deallocated.\n", block);
            } else {
                printf("Block %d is already free.\n", block);
            }
        } else {
            printf("Invalid block number: %d\n", block);
        }
    }
    printf("\nBitmap after deallocation:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    printf("\n");
    return 0;
} 
