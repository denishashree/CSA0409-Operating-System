3. FCFS, SSTF and SCAN Disk Scheduling
#include <stdio.h>
#include <stdlib.h>
#define MAX 100
void fcfs(int request[], int n, int head) {
    int i, total = 0, current = head;
    printf("\nFCFS Seek Sequence: %d ", head);
    for (i = 0; i < n; i++) {
        total += abs(current - request[i]);
        current = request[i];
        printf("-> %d ", current);
    }
    printf("\nTotal Seek Time = %d\n", total);
}
void sstf(int request[], int n, int head) {
    int visited[MAX] = {0};
    int i, count, min, index;
    int current = head, total = 0;
    printf("\nSSTF Seek Sequence: %d ", head);
    for (count = 0; count < n; count++) {
        min = 999999;
        index = -1;
        for (i = 0; i < n; i++) {
            if (!visited[i]) {
                int distance = abs(current - request[i]);
                if (distance < min) {
                    min = distance;
                    index = i;
                }
            }
        }
        visited[index] = 1;
        total += abs(current - request[index]);
        current = request[index];
        printf("-> %d ", current);
    }
    printf("\nTotal Seek Time = %d\n", total);
}
void scan(int request[], int n, int head, int diskSize) {
    int temp[MAX], i, j;
    int total = 0, current = head;
    for (i = 0; i < n; i++)
        temp[i] = request[i];
    /* Sort requests */
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (temp[i] > temp[j]) {
                int t = temp[i];
                temp[i] = temp[j];
                temp[j] = t;
            }
        }
    }
    printf("\nSCAN Seek Sequence: %d ", head);

    /* Move right */
    for (i = 0; i < n; i++) {
        if (temp[i] >= head) {
            total += abs(current - temp[i]);
            current = temp[i];
            printf("-> %d ", current);
        }
    }

    /* Go to end */
    if (current != diskSize - 1) {
        total += abs(current - (diskSize - 1));
        current = diskSize - 1;
        printf("-> %d ", current);
    }

    /* Move left */
    for (i = n - 1; i >= 0; i--) {
        if (temp[i] < head) {
            total += abs(current - temp[i]);
            current = temp[i];
            printf("-> %d ", current);
        }
    }

    printf("\nTotal Seek Time = %d\n", total);
}

int main() {
    int request[MAX];
    int n, head, diskSize;
    int i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("\n----- DISK SCHEDULING -----\n");

    fcfs(request, n, head);
    sstf(request, n, head);
    scan(request, n, head, diskSize);

    return 0;
}
